+    return value ? 'TRUE' : 'FALSE'
+  }
+  if (typeof value === 'number' && Number.isFinite(value)) {
+    if (Number.isInteger(value) && !Number.isSafeInteger(value)) return value.toExponential()
+    return Object.is(value, -0) ? '-0.0' : `${value}`
+  }
