#!/usr/bin/env python3
"""
Neuralink Software Engineering Take-Home Challenge - `./server` executable
Usage: ./server --port <port> --host <host>
"""

import argparse
import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

from nl_image_engine import (
    decode_nl_image,
    decode_rotate_request,
    encode_nl_image,
    mean_filter_nl_image,
    rotate_nl_image,
)


class NLImageRPCHandler(BaseHTTPRequestHandler):
    def log_message(self, format, *args):
        pass

    def do_POST(self):
        try:
            content_len = int(self.headers.get("Content-Length", "0"))
            raw_body = self.rfile.read(content_len) if content_len > 0 else b""

            if self.path.endswith("RotateImage"):
                req = decode_rotate_request(raw_body)
                resp_msg = rotate_nl_image(req)
                resp_bytes = encode_nl_image(resp_msg)
            elif self.path.endswith("MeanFilter"):
                req_img = decode_nl_image(raw_body)
                resp_msg = mean_filter_nl_image(req_img)
                resp_bytes = encode_nl_image(resp_msg)
            else:
                self.send_response(404)
                self.end_headers()
                self.wfile.write(b"Unknown RPC method")
                return

            self.send_response(200)
            self.send_header("Content-Type", "application/x-protobuf")
            self.send_header("Content-Length", str(len(resp_bytes)))
            self.end_headers()
            self.wfile.write(resp_bytes)
        except Exception as exc:
            err_bytes = str(exc).encode("utf-8")
            self.send_response(400)
            self.send_header("Content-Type", "text/plain; charset=utf-8")
            self.send_header("Content-Length", str(len(err_bytes)))
            self.end_headers()
            self.wfile.write(err_bytes)


def main():
    parser = argparse.ArgumentParser(description="NLImageService Server")
    parser.add_argument("--host", type=str, default="127.0.0.1", required=True)
    parser.add_argument("--port", type=int, default=50051, required=True)
    args = parser.parse_args()

    srv = ThreadingHTTPServer((args.host, args.port), NLImageRPCHandler)
    print(f"NLImageService listening on {args.host}:{args.port}", flush=True)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        srv.server_close()


if __name__ == "__main__":
    main()
