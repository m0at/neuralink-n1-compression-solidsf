+    filters = tf.tile(k_tf[None, :, None, None], [1, 1, C, 1])
+    padded = tf.pad(x_tf, [[0, 0], [len(kernel_norm) - 1, 0], [0, 0]])[:, None, :, :]
+    filtered = tf.nn.depthwise_conv2d(padded, filters, strides=[1, 1, 1, 1], padding='VALID')
+    return tf.squeeze(filtered, 1)
